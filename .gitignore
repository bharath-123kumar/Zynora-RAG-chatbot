*.db
*.db-journal
*.sqlite
*.sqlite3

# React production build output
zynora/frontend/build/

# Prisma generated client (re-generated at deploy time)
zynora/backend/node_modules/.prisma/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test artefacts / scratch
zynora/tests/scratch/
