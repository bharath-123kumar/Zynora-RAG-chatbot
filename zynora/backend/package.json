{
  "name": "zynora-backend",
  "version": "2.0.0",
  "description": "Zynora 2.0 RAG Chatbot Backend API for Zyngram Knowledge Intelligence",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "postinstall": "prisma generate",
    "render:build": "prisma generate && prisma db push --accept-data-loss && node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "ingest": "node -e \"require('./src/services/ingestion/ingestionService').ingestAllKnowledgeDocs()\"",
    "test": "node ../tests/run-all-tests.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  }
}
